{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gopulse.invalid/schemas/phase18-bottleneck-diagnostic.v1.json",
  "title": "GoPulse Phase 18-02 bottleneck diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate", "finding", "reason_code", "summary", "rates_per_second", "evidence"],
  "properties": {
    "schema": {"const": "gopulse.phase18.bottleneck-diagnostic.v1"},
    "candidate": {"type": "object"},
    "finding": {"enum": ["component", "shared_dependency", "load_generator", "inconclusive"]},
    "reason_code": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "rates_per_second": {"type": "object"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source", "sha256"]}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gopulse.local/schemas/phase20-capacity-profile.schema.json",
  "title": "GoPulse Phase 20 isolated diagnostic profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "target_candidate_version",
    "resource_budget",
    "host",
    "recipe",
    "workload",
    "stages",
    "repetitions",
    "gates",
    "stop_conditions",
    "sampling",
    "statistics",
    "diagnostic"
  ],
  "properties": {
    "schema_version": {
      "const": "gopulse.phase20.capacity-profile.v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "target_candidate_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "contract_id"],
      "properties": {
        "path": { "const": "deploy/phase20-resource-budgets.json" },
        "schema": { "const": "deploy/phase20-resource-budgets.schema.json" },
        "contract_id": { "const": "phase20-05-budget-contract-20261001" }
      }
    },
    "host": {
      "$ref": "#/$defs/host"
    },
    "recipe": {
      "$ref": "#/$defs/recipe"
    },
    "workload": {
      "$ref": "#/$defs/workload"
    },
    "stages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/stage"
        },
        {
          "$ref": "#/$defs/stage"
        },
        {
          "$ref": "#/$defs/stage"
        },
        {
          "$ref": "#/$defs/stage"
        }
      ],
      "items": false
    },
    "repetitions": {
      "const": 3
    },
    "gates": {
      "$ref": "#/$defs/gates"
    },
    "stop_conditions": {
      "$ref": "#/$defs/stopConditions"
    },
    "sampling": {
      "$ref": "#/$defs/sampling"
    },
    "statistics": {
      "$ref": "#/$defs/statistics"
    },
    "diagnostic": {
      "const": {
        "drain_seconds": 30,
        "recovery_seconds": 120,
        "poll_seconds": 1,
        "stage_isolation": "owned_empty_project",
        "clock_assumption": "same_host_utc",
        "clock_error_ms": 10,
        "metric_timestamp_quantization_ms": 1,
        "event_plugin_id": "redis-exporter",
        "event_operations": [
          "stop",
          "start"
        ],
        "observer_comparison": {
          "target_rps": 50,
          "seconds": 5,
          "workers": 8,
          "route": "GET /api/v1/users/me"
        }
      }
    }
  },
  "$defs": {
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "host_os",
        "kernel_contains",
        "cpu_count_min",
        "memory_bytes_min",
        "swap_bytes_min",
        "disk_free_bytes_min",
        "docker_server_os",
        "docker_server_arch",
        "compose_min_version"
      ],
      "properties": {
        "platform": {
          "const": "linux/amd64"
        },
        "host_os": {
          "const": "Linux"
        },
        "kernel_contains": {
          "type": "string",
          "minLength": 1
        },
        "cpu_count_min": {
          "$ref": "#/$defs/positiveInteger"
        },
        "memory_bytes_min": {
          "$ref": "#/$defs/positiveInteger"
        },
        "swap_bytes_min": {
          "$ref": "#/$defs/positiveInteger"
        },
        "disk_free_bytes_min": {
          "$ref": "#/$defs/positiveInteger"
        },
        "docker_server_os": {
          "const": "linux"
        },
        "docker_server_arch": {
          "const": "amd64"
        },
        "compose_min_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "recipeCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "users",
        "posts",
        "comments",
        "post_likes",
        "user_follows",
        "post_bookmarks",
        "business_outbox",
        "notifications"
      ],
      "properties": {
        "users": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "posts": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "comments": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "post_likes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "user_follows": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "post_bookmarks": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "business_outbox": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "notifications": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "idRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first",
        "last"
      ],
      "properties": {
        "first": {
          "$ref": "#/$defs/positiveInteger"
        },
        "last": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "seed",
        "counts",
        "id_ranges",
        "digest"
      ],
      "properties": {
        "schema_version": {
          "const": "gopulse.phase18.recipe.v1"
        },
        "seed": {
          "$ref": "#/$defs/positiveInteger"
        },
        "counts": {
          "$ref": "#/$defs/recipeCounts"
        },
        "id_ranges": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "users",
            "posts",
            "comments"
          ],
          "properties": {
            "users": {
              "$ref": "#/$defs/idRange"
            },
            "posts": {
              "$ref": "#/$defs/idRange"
            },
            "comments": {
              "$ref": "#/$defs/idRange"
            }
          }
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "mixEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "percent"
      ],
      "properties": {
        "category": {
          "enum": [
            "read",
            "search",
            "notification_bookmark_read",
            "content_write",
            "interaction_write",
            "identity_session"
          ]
        },
        "percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "method",
        "template",
        "allowed_statuses"
      ],
      "properties": {
        "category": {
          "enum": [
            "read",
            "search",
            "notification_bookmark_read",
            "content_write",
            "interaction_write",
            "identity_session"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PATCH",
            "PUT",
            "DELETE"
          ]
        },
        "template": {
          "type": "string",
          "pattern": "^(GET|POST|PATCH|PUT|DELETE) /[^?]+$"
        },
        "allowed_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "virtual_users",
        "request_timeout_seconds",
        "mix",
        "routes"
      ],
      "properties": {
        "virtual_users": {
          "const": 1024
        },
        "request_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "mix": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/mixEntry"
          }
        },
        "routes": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "items": {
            "$ref": "#/$defs/route"
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "target_rps",
        "warmup_target_rps",
        "warmup_seconds",
        "measurement_seconds",
        "recovery_seconds"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^rps-(50|100|150|200)$"
        },
        "target_rps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "warmup_target_rps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "warmup_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "measurement_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "recovery_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synchronous",
        "asynchronous",
        "observability"
      ],
      "properties": {
        "synchronous": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_achieved_rps_ratio",
            "max_p95_ms",
            "max_p99_ms",
            "max_timeout_rate",
            "max_unexpected_error_rate",
            "max_explicit_reject_rate",
            "max_schedule_lag_ms"
          ],
          "properties": {
            "min_achieved_rps_ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "max_p95_ms": {
              "$ref": "#/$defs/positiveNumber"
            },
            "max_p99_ms": {
              "$ref": "#/$defs/positiveNumber"
            },
            "max_timeout_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max_unexpected_error_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max_explicit_reject_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max_schedule_lag_ms": {
              "$ref": "#/$defs/positiveNumber"
            }
          }
        },
        "asynchronous": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_recovery_seconds",
            "max_outbox_pending",
            "max_rabbit_ready",
            "max_rabbit_unacked",
            "max_kafka_lag"
          ],
          "properties": {
            "max_recovery_seconds": {
              "$ref": "#/$defs/positiveNumber"
            },
            "max_outbox_pending": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "max_rabbit_ready": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "max_rabbit_unacked": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "max_kafka_lag": {
              "$ref": "#/$defs/nonNegativeInteger"
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_recovery_seconds",
            "require_metric_progress",
            "require_log_progress",
            "require_event_progress"
          ],
          "properties": {
            "max_recovery_seconds": {
              "$ref": "#/$defs/positiveNumber"
            },
            "require_metric_progress": {
              "type": "boolean"
            },
            "require_log_progress": {
              "type": "boolean"
            },
            "require_event_progress": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "stopConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oom",
        "ownership_lost",
        "unsafe_cleanup",
        "profile_hard_error",
        "preserve_unexecuted_stages"
      ],
      "properties": {
        "oom": {
          "const": true
        },
        "ownership_lost": {
          "const": true
        },
        "unsafe_cleanup": {
          "const": true
        },
        "profile_hard_error": {
          "const": true
        },
        "preserve_unexecuted_stages": {
          "const": true
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_seconds",
        "required_signals",
        "required_components"
      ],
      "properties": {
        "interval_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "required_signals": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "host_cpu",
              "host_rss",
              "load_cpu",
              "load_rss",
              "load_scheduler_lag",
              "sut_cpu",
              "sut_rss",
              "sut_saturation",
              "outbox",
              "rabbitmq",
              "kafka_lag"
            ]
          }
        },
        "required_components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "percentiles",
        "aggregations",
        "cv_definition",
        "retain_raw_repetitions",
        "do_not_merge_latency_samples"
      ],
      "properties": {
        "percentiles": {
          "const": [
            0.5,
            0.95,
            0.99
          ]
        },
        "aggregations": {
          "const": [
            "median",
            "min",
            "max",
            "cv"
          ]
        },
        "cv_definition": {
          "const": "population_stddev_div_mean_percent"
        },
        "retain_raw_repetitions": {
          "const": true
        },
        "do_not_merge_latency_samples": {
          "const": true
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gopulse.local/schemas/load-report.schema.json",
  "title": "GoPulse load reports",
  "oneOf": [
    {"$ref": "#/$defs/phase18Report"},
    {"$ref": "#/$defs/phase19Report"}
  ],
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "succeeded", "explicit_rejects", "timeouts", "errors"],
      "properties": {
        "requests": {"type": "integer", "minimum": 0},
        "succeeded": {"type": "integer", "minimum": 0},
        "explicit_rejects": {"type": "integer", "minimum": 0},
        "timeouts": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0}
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50_ms", "p95_ms", "p99_ms", "max_ms"],
      "properties": {
        "p50_ms": {"type": "number", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0},
        "p99_ms": {"type": "number", "minimum": 0},
        "max_ms": {"type": "number", "minimum": 0}
      }
    },
    "latencyByCategory": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/latency"}
    },
    "countsByCategory": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/counts"}
    },
    "phase18Route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "method", "template", "counts", "statuses", "latency"],
      "properties": {
        "category": {"enum": ["read", "search", "notification_bookmark_read", "content_write", "interaction_write", "identity_session"]},
        "method": {"type": "string"},
        "template": {"type": "string"},
        "counts": {"$ref": "#/$defs/counts"},
        "statuses": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "latency": {"$ref": "#/$defs/latency"}
      }
    },
    "phase18Phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target_rps", "duration_seconds", "scheduled_slots", "dropped_slots", "max_schedule_lag_ms", "completed_requests", "counts", "latency_by_category", "counts_by_category"],
      "properties": {
        "name": {"enum": ["warmup", "steady", "burst"]},
        "target_rps": {"type": "number", "exclusiveMinimum": 0},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "scheduled_slots": {"type": "integer", "minimum": 0},
        "dropped_slots": {"type": "integer", "minimum": 0},
        "max_schedule_lag_ms": {"type": "number", "minimum": 0},
        "completed_requests": {"type": "integer", "minimum": 0},
        "counts": {"$ref": "#/$defs/counts"},
        "latency_by_category": {"$ref": "#/$defs/latencyByCategory"},
        "counts_by_category": {"$ref": "#/$defs/countsByCategory"}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rss_bytes", "goroutines", "heap_alloc_bytes"],
      "properties": {
        "rss_bytes": {"type": "integer", "minimum": 0},
        "goroutines": {"type": "integer", "minimum": 0},
        "heap_alloc_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "phase18Report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "seed", "started_at", "finished_at", "steady_target_rps", "burst_target_rps", "virtual_users", "phases", "routes", "total", "load_process"],
      "properties": {
        "schema_version": {"const": "gopulse.phase18.load.v1"},
        "seed": {"type": "integer", "minimum": 0},
        "started_at": {"type": "string"},
        "finished_at": {"type": "string"},
        "steady_target_rps": {"type": "number"},
        "burst_target_rps": {"type": "number"},
        "virtual_users": {"type": "integer", "minimum": 1},
        "phases": {"type": "array", "items": {"$ref": "#/$defs/phase18Phase"}},
        "routes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/phase18Route"}},
        "total": {"$ref": "#/$defs/counts"},
        "load_process": {"$ref": "#/$defs/process"}
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "succeeded", "explicit_rejects", "rejected_429", "rejected_503", "timeouts", "transport_errors", "unexpected_errors"],
      "properties": {
        "requests": {"type": "integer", "minimum": 0},
        "succeeded": {"type": "integer", "minimum": 0},
        "explicit_rejects": {"type": "integer", "minimum": 0},
        "rejected_429": {"type": "integer", "minimum": 0},
        "rejected_503": {"type": "integer", "minimum": 0},
        "timeouts": {"type": "integer", "minimum": 0},
        "transport_errors": {"type": "integer", "minimum": 0},
        "unexpected_errors": {"type": "integer", "minimum": 0}
      }
    },
    "capacityWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target_rps", "duration_seconds", "scheduled_slots", "dropped_slots", "max_schedule_lag_ms", "completed_requests", "achieved_rps", "outcomes", "statuses", "latency"],
      "properties": {
        "name": {"enum": ["warmup", "measurement", "recovery"]},
        "target_rps": {"type": "number", "minimum": 0},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "scheduled_slots": {"type": "integer", "minimum": 0},
        "dropped_slots": {"type": "integer", "minimum": 0},
        "max_schedule_lag_ms": {"type": "number", "minimum": 0},
        "completed_requests": {"type": "integer", "minimum": 0},
        "achieved_rps": {"type": "number", "minimum": 0},
        "outcomes": {"$ref": "#/$defs/outcomes"},
        "statuses": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "latency": {"$ref": "#/$defs/latency"}
      }
    },
    "capacityStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target_rps", "status", "warmup", "measurement", "recovery"],
      "properties": {
        "name": {"pattern": "^rps-(50|100|150|200)$"},
        "target_rps": {"type": "number", "exclusiveMinimum": 0},
        "status": {"enum": ["complete", "not_executed"]},
        "warmup": {"$ref": "#/$defs/capacityWindow"},
        "measurement": {"$ref": "#/$defs/capacityWindow"},
        "recovery": {"$ref": "#/$defs/capacityWindow"}
      }
    },
    "profileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"type": "string"},
        "sha256": {"pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision", "manifest_sha256"],
      "properties": {
        "version": {"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "revision": {"pattern": "^[0-9a-f]{40}$"},
        "manifest_sha256": {"pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "recipeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "seed", "digest"],
      "properties": {
        "schema_version": {"const": "gopulse.phase18.recipe.v1"},
        "seed": {"type": "integer", "minimum": 1},
        "digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "total"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 3},
        "total": {"const": 3}
      }
    },
    "resourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_samples_path", "summary_path", "raw_samples_sha256", "raw_sample_records"],
      "properties": {
        "raw_samples_path": {"type": "string", "minLength": 1},
        "summary_path": {"type": "string", "minLength": 1},
        "raw_samples_sha256": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "raw_sample_records": {"type": "integer", "minimum": 1}
      }
    },
    "progressReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "records"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "records": {"type": "integer", "minimum": 1}
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {"enum": ["oom", "ownership_lost", "unsafe_cleanup", "profile_hard_error"]},
        "stage": {"type": "string"},
        "detail": {"type": "string"}
      }
    },
    "phase19Report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile", "candidate", "recipe", "repeat", "execution_status", "started_at", "finished_at", "stages", "total", "load_process"],
      "properties": {
        "schema_version": {"const": "gopulse.phase19.load.v1"},
        "profile": {"$ref": "#/$defs/profileBinding"},
        "candidate": {"$ref": "#/$defs/candidateBinding"},
        "recipe": {"$ref": "#/$defs/recipeBinding"},
        "repeat": {"$ref": "#/$defs/repeat"},
        "execution_status": {"enum": ["complete", "incomplete"]},
        "started_at": {"type": "string"},
        "finished_at": {"type": "string"},
        "stages": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/capacityStage"}},
        "total": {"$ref": "#/$defs/outcomes"},
        "load_process": {"$ref": "#/$defs/process"},
        "progress": {"$ref": "#/$defs/progressReference"},
        "resources": {"$ref": "#/$defs/resourceReference"},
        "stop": {"$ref": "#/$defs/stop"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gopulse.local/schemas/phase20-sustained-profile.schema.json",
  "title": "GoPulse Phase 20 sustained resource profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "candidate_version",
    "base_capacity_profile",
    "resource_budget_contract_id",
    "recipe",
    "workload",
    "repetitions",
    "duration_seconds",
    "warmup_seconds",
    "sampling",
    "fault",
    "gates",
    "stop_conditions",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": "gopulse.phase20.sustained-profile.v1" },
    "profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "candidate_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "base_capacity_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "recipe_digest"],
      "properties": {
        "path": { "const": "loadtest/phase20-capacity-profile.json" },
        "schema": { "const": "loadtest/phase20-capacity-profile.schema.json" },
        "recipe_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "resource_budget_contract_id": { "const": "phase20-05-budget-contract-20261001-r2" },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "digest", "counts", "id_ranges"],
      "properties": {
        "seed": { "const": 18002005 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "id_ranges": { "type": "object", "additionalProperties": true }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_rps", "virtual_users", "mix", "request_timeout_seconds"],
      "properties": {
        "target_rps": { "const": 200 },
        "virtual_users": { "const": 1024 },
        "request_timeout_seconds": { "const": 5 },
        "mix": { "type": "array", "minItems": 1 },
        "route_source": { "type": "string" }
      }
    },
    "repetitions": { "const": 2 },
    "duration_seconds": { "const": 3600 },
    "warmup_seconds": { "const": 900 },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval_seconds", "missing_sample_max_ratio", "required_signals"],
      "properties": {
        "interval_seconds": { "const": 5 },
        "missing_sample_max_ratio": { "const": 0.01 },
        "required_signals": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_minute", "duration_seconds", "target", "action", "recovery_action"],
      "properties": {
        "at_minute": { "const": 15 },
        "duration_seconds": { "const": 60 },
        "target": { "const": "phase20-collector" },
        "action": { "const": "stop_then_start" },
        "recovery_action": { "const": "docker compose start phase20-collector" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_budget_ids", "recovery_seconds", "business_error_rate", "disk_free_bytes"],
      "properties": {
        "resource_budget_ids": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } },
        "recovery_seconds": { "const": 120 },
        "business_error_rate": { "const": 0 },
        "disk_free_bytes": { "const": 96636764160 }
      }
    },
    "stop_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oom", "ownership_lost", "unsafe_cleanup", "disk_safety_waterline", "fault_not_effective"],
      "properties": {
        "oom": { "const": true },
        "ownership_lost": { "const": true },
        "unsafe_cleanup": { "const": true },
        "disk_safety_waterline": { "const": true },
        "fault_not_effective": { "const": true }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_pattern", "per_run_files"],
      "properties": {
        "root_pattern": { "const": "/var/tmp/gopulse-phase20-05-20261001/closure/u2/" },
        "per_run_files": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}

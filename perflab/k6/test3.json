{
  "schema_version": "gopulse.k6.load-config.v1",
  "target": {
    "base_url": "http://127.0.0.1:18080",
    "health_url": "http://127.0.0.1:18080/ready",
    "backlog_url": "http://127.0.0.1:18081/backlog",
    "backlog_json_path": "pending",
    "corpus_path": ".run/pt3/corpus.json",
    "credentials_path": ".run/pt3/credentials.json",
    "cookie_name": "gopulse_session"
  },
  "workload": {
    "virtual_users": 1024,
    "request_timeout_seconds": 5,
    "mix": [
      {
        "category": "read",
        "percent": 45
      },
      {
        "category": "search",
        "percent": 10
      },
      {
        "category": "notification_bookmark_read",
        "percent": 10
      },
      {
        "category": "content_write",
        "percent": 15
      },
      {
        "category": "interaction_write",
        "percent": 15
      },
      {
        "category": "identity_session",
        "percent": 5
      }
    ],
    "profile": "smooth-mixed"
  },
  "boundary": {
    "start_rps": 10,
    "multiplier": 2,
    "max_rps": 2560,
    "warmup_seconds": 30,
    "measurement_seconds": 300,
    "recovery_seconds": 600
  },
  "refine": {
    "measurement_seconds": 300,
    "recovery_seconds": 600,
    "max_relative_width": 0.1,
    "max_iterations": 8
  },
  "soak": {
    "stable_capacity_ratio": 1,
    "duration_seconds": 1800,
    "recovery_seconds": 600
  },
  "thresholds": {
    "max_p95_ms": 1000,
    "max_p99_ms": 2000,
    "max_error_rate": 0.01,
    "min_achieved_rps_ratio": 0.95,
    "max_dropped_iteration_rate": 0.01,
    "early_stop_error_rate": 0.2,
    "early_stop_seconds": 30,
    "health_failure_seconds": 30
  },
  "recovery": {
    "poll_seconds": 1,
    "baseline_tolerance": 0,
    "require_observation": true
  },
  "k6": {
    "script": "perflab/k6/workload.js"
  },
  "report_dir": ".run/pt3/reports",
  "continuous": true,
  "safety_file": ".run/pt3/guard.json"
}

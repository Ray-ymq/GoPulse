{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gopulse.local/schemas/k6-load-report.schema.json",
  "title": "GoPulse k6 load reports",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "run_id",
    "config_path",
    "config_sha256",
    "started_at",
    "finished_at",
    "execution_status",
    "thresholds",
    "stages",
    "boundary",
    "resources"
  ],
  "properties": {
    "schema_version": {"const": "gopulse.k6.load.v1"},
    "mode": {"enum": ["boundary", "refine", "soak"]},
    "run_id": {"type": "string", "minLength": 1},
    "config_path": {"type": "string", "minLength": 1},
    "config_sha256": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "execution_status": {"enum": ["running", "complete", "incomplete"]},
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}},
    "boundary": {"$ref": "#/$defs/boundary"},
    "resources": {"$ref": "#/$defs/resources"}
  },
  "$defs": {
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_p95_ms", "max_p99_ms", "max_error_rate", "min_achieved_rps_ratio", "max_dropped_iteration_rate", "early_stop_error_rate", "early_stop_seconds", "health_failure_seconds"],
      "properties": {
        "max_p95_ms": {"type": "number", "minimum": 0},
        "max_p99_ms": {"type": "number", "minimum": 0},
        "max_error_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "min_achieved_rps_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "max_dropped_iteration_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "early_stop_error_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "early_stop_seconds": {"type": "number", "minimum": 0},
        "health_failure_seconds": {"type": "number", "minimum": 0}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_found", "capacity_judgement"],
      "properties": {
        "stable_rps": {"type": "number", "minimum": 0},
        "first_unstable_rps": {"type": "number", "minimum": 0},
        "boundary_found": {"type": "boolean"},
        "capacity_judgement": {"type": "string", "minLength": 1}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "load_cpu_percent": {"type": "number", "minimum": 0},
        "load_rss_bytes": {"type": "integer", "minimum": 0},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target_rps", "status", "classification", "warmup", "measurement", "recovery", "k6_exit_code"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "target_rps": {"type": "number", "exclusiveMinimum": 0},
        "status": {"enum": ["stable", "unstable", "capacity_insufficient", "environment_failure", "incomplete", "not_executed"]},
        "classification": {"type": "array", "items": {"type": "string"}},
        "warmup": {"$ref": "#/$defs/window"},
        "measurement": {"$ref": "#/$defs/window"},
        "recovery": {"$ref": "#/$defs/recovery"},
        "k6_exit_code": {"type": "integer"},
        "k6_summary_path": {"type": "string"},
        "error": {"type": "string"}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_rps", "actual_request_rate", "successful_throughput", "requests", "successful_requests", "p95_ms", "p99_ms", "error_rate", "health_failure_rate", "dropped_iterations", "dropped_iteration_rate", "errors", "routes"],
      "properties": {
        "target_rps": {"type": "number", "minimum": 0},
        "actual_request_rate": {"type": "number", "minimum": 0},
        "successful_throughput": {"type": "number", "minimum": 0},
        "requests": {"type": "integer", "minimum": 0},
        "successful_requests": {"type": "integer", "minimum": 0},
        "delete_succeeded": {"type": "integer", "minimum": 0},
        "delete_already_absent": {"type": "integer", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0},
        "p99_ms": {"type": "number", "minimum": 0},
        "error_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "health_failure_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "dropped_iterations": {"type": "integer", "minimum": 0},
        "dropped_iteration_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "errors": {"$ref": "#/$defs/errors"},
        "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}}
      }
    },
    "errors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rejected_429", "rejected_503", "timeouts", "transport_errors", "unexpected_errors"],
      "properties": {
        "rejected_429": {"type": "integer", "minimum": 0},
        "rejected_503": {"type": "integer", "minimum": 0},
        "timeouts": {"type": "integer", "minimum": 0},
        "transport_errors": {"type": "integer", "minimum": 0},
        "unexpected_errors": {"type": "integer", "minimum": 0}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "category", "method", "requests", "p95_ms", "p99_ms", "error_rate"],
      "properties": {
        "template": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "requests": {"type": "integer", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0},
        "p99_ms": {"type": "number", "minimum": 0},
        "error_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recovered", "elapsed_seconds"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "baseline": {"type": "number", "minimum": 0},
        "after": {"type": "number", "minimum": 0},
        "recovered": {"type": "boolean"},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "error": {"type": "string"}
      }
    }
  }
}

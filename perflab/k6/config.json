{
  "schema_version": "gopulse.k6.load-config.v1",
  "target": {
    "base_url": "http://127.0.0.1:18080",
    "health_url": "http://127.0.0.1:18080/ready",
    "backlog_url": "",
    "backlog_json_path": "pending",
    "corpus_path": ".run/load/corpus.json",
    "credentials_path": ".run/load/credentials.json",
    "cookie_name": "gopulse_session"
  },
  "workload": {
    "virtual_users": 1024,
    "request_timeout_seconds": 5,
    "mix": [
      {"category": "read", "percent": 45},
      {"category": "search", "percent": 10},
      {"category": "notification_bookmark_read", "percent": 10},
      {"category": "content_write", "percent": 15},
      {"category": "interaction_write", "percent": 15},
      {"category": "identity_session", "percent": 5}
    ]
  },
  "boundary": {
    "start_rps": 10,
    "multiplier": 2,
    "max_rps": 1000,
    "warmup_seconds": 30,
    "measurement_seconds": 120,
    "recovery_seconds": 120
  },
  "refine": {
    "measurement_seconds": 300,
    "recovery_seconds": 120,
    "max_relative_width": 0.1,
    "max_iterations": 8
  },
  "soak": {
    "stable_capacity_ratio": 0.8,
    "duration_seconds": 1800,
    "recovery_seconds": 120
  },
  "thresholds": {
    "max_p95_ms": 1000,
    "max_p99_ms": 2000,
    "max_error_rate": 0.01,
    "min_achieved_rps_ratio": 0.95,
    "max_dropped_iteration_rate": 0.01,
    "early_stop_error_rate": 0.2,
    "early_stop_seconds": 30,
    "health_failure_seconds": 30
  },
  "recovery": {
    "poll_seconds": 5,
    "baseline_tolerance": 0,
    "require_observation": true
  },
  "k6": {
    "script": "perflab/k6/workload.js"
  },
  "report_dir": ".run/load/reports"
}

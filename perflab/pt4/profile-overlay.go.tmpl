package main

import (
	"net"
	"net/http"
	"net/http/pprof"
	"os"
	"runtime"
	"strconv"
	"time"
)

// 此文件只通过测试四构建 overlay 加入诊断二进制。
func init() {
	address := os.Getenv("PERFLAB_PPROF_ADDR")
	if address == "" {
		return
	}
	host, _, err := net.SplitHostPort(address)
	if err != nil || net.ParseIP(host) == nil || !net.ParseIP(host).IsLoopback() {
		panic("PERFLAB_PPROF_ADDR 必须使用回环 IP")
	}
	for _, item := range []struct {
		name string
		set  func(int)
	}{
		{"PERFLAB_BLOCK_RATE", runtime.SetBlockProfileRate},
		{"PERFLAB_MUTEX_FRACTION", func(value int) { runtime.SetMutexProfileFraction(value) }},
	} {
		if text := os.Getenv(item.name); text != "" {
			value, err := strconv.Atoi(text)
			if err != nil || value < 0 {
				panic("剖析采样参数必须为非负整数")
			}
			item.set(value)
		}
	}
	mux := http.NewServeMux()
	mux.HandleFunc("GET /debug/pprof/profile", pprof.Profile)
	mux.HandleFunc("GET /debug/pprof/symbol", pprof.Symbol)
	for _, name := range []string{"heap", "goroutine", "block", "mutex"} {
		mux.Handle("GET /debug/pprof/"+name, pprof.Handler(name))
	}
	listener, err := net.Listen("tcp", address)
	if err != nil {
		panic("测试剖析监听失败")
	}
	server := &http.Server{Handler: mux, ReadHeaderTimeout: time.Second, WriteTimeout: 70 * time.Second}
	go func() {
		if err := server.Serve(listener); err != nil && err != http.ErrServerClosed {
			panic("测试剖析服务退出")
		}
	}()
}

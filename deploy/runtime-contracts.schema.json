{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "product_version",
    "resource_budget",
    "platform",
    "authority",
    "components",
    "env_example",
    "plugin_manifest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "1"
    },
    "product_version": {
      "type": "string"
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "contract_id"],
      "properties": {
        "path": { "const": "deploy/phase20-resource-budgets.json" },
        "schema": { "const": "deploy/phase20-resource-budgets.schema.json" },
        "contract_id": { "const": "phase20-05-budget-contract-20261001" }
      }
    },
    "platform": {
      "const": "linux/amd64"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "contract_kind",
        "diagnostic_mode",
        "host_port_policy",
        "evidence_schema"
      ],
      "properties": {
        "source": {
          "const": "deploy/runtime-contracts.json"
        },
        "contract_kind": {
          "const": "machine-runtime-contract"
        },
        "diagnostic_mode": {
          "const": "direct-private-probe"
        },
        "host_port_policy": {
          "const": "no-new-host-ports"
        },
        "evidence_schema": {
          "const": "gopulse.phase18.scale-closure.v1"
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "process_id",
          "role",
          "module",
          "entrypoint",
          "configuration",
          "compose_service",
          "plugin_id",
          "compose_services",
          "replica",
          "diagnostic",
          "budgets",
          "environment",
          "listeners",
          "probes",
          "hard_dependencies",
          "soft_dependencies",
          "check_timeout_ms",
          "cache_ms",
          "max_concurrent_checks",
          "shutdown_seconds",
          "stop_grace_seconds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "process_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "role": {
            "enum": [
              "business-api",
              "business-worker",
              "search-indexer",
              "observability-router",
              "observability-marshaller",
              "observability-monitor",
              "plugin-exporter"
            ]
          },
          "module": {
            "type": "string"
          },
          "entrypoint": {
            "type": "string"
          },
          "configuration": {
            "type": "string"
          },
          "compose_service": {
            "type": [
              "string",
              "null"
            ]
          },
          "plugin_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "compose_services": {
            "type": "array",
            "minItems": 0,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "replica": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "ownership",
              "identity_env",
              "identity_source",
              "identity_pattern",
              "min",
              "max",
              "configured",
              "instances"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "scalable",
                  "singleton"
                ]
              },
              "ownership": {
                "enum": [
                  "multi-owner",
                  "partition-owner",
                  "single-owner"
                ]
              },
              "identity_env": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "identity_source": {
                "enum": [
                  "environment",
                  "componentmetrics-fallback"
                ]
              },
              "identity_pattern": {
                "type": "string"
              },
              "min": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "configured": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "instances": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                }
              }
            }
          },
          "diagnostic": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "independent",
              "via_monitor",
              "probe_listener",
              "paths",
              "identity_env",
              "identity_source",
              "capacity_signals",
              "host_port_published"
            ],
            "properties": {
              "independent": {
                "const": true
              },
              "via_monitor": {
                "const": false
              },
              "probe_listener": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^/(startup|live|ready|health)$"
                }
              },
              "identity_env": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "identity_source": {
                "enum": [
                  "environment",
                  "componentmetrics-fallback"
                ]
              },
              "capacity_signals": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "description": "Finite diagnostic signals; Backend's HTTP latency distribution is exposed as fixed buckets, count, and sum families.",
                "items": {
                  "type": "string",
                  "enum": [
                    "metrics",
                    "http_concurrency",
                    "http_latency_distribution",
                    "mysql_pool",
                    "prefetch",
                    "in_flight",
                    "buffered_records",
                    "buffered_bytes",
                    "backpressure",
                    "records_in_flight",
                    "retrying",
                    "partition_lag",
                    "target_blocked",
                    "event_queue",
                    "plugins_running",
                    "up"
                  ],
                  "pattern": "^[a-z0-9_-]+$"
                }
              },
              "host_port_published": {
                "const": false
              }
            }
          },
          "budgets": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "connections",
              "queues",
              "in_flight",
              "shutdown_seconds",
              "stop_grace_seconds"
            ],
            "properties": {
              "connections": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "per_instance",
                    "total"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z0-9_-]+$"
                    },
                    "per_instance": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "queues": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "capacity"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z0-9_-]+$"
                    },
                    "capacity": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "in_flight": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "capacity"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z0-9_-]+$"
                    },
                    "capacity": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "shutdown_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "stop_grace_seconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "environment": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "type",
                "sensitive",
                "required",
                "default",
                "compose_value",
                "aliases"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "string",
                    "integer",
                    "boolean",
                    "duration",
                    "host",
                    "url"
                  ]
                },
                "sensitive": {
                  "type": "boolean"
                },
                "required": {
                  "type": "boolean"
                },
                "default": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "compose_value": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "aliases": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "key",
                      "expires"
                    ],
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "expires": {
                        "type": "string",
                        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                      }
                    }
                  }
                }
              }
            }
          },
          "listeners": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "port",
                "scope"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "port": {
                  "type": "integer",
                  "minimum": 0
                },
                "scope": {
                  "type": "string"
                }
              }
            }
          },
          "probes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startup",
              "live",
              "ready",
              "health"
            ],
            "properties": {
              "startup": {
                "type": "string"
              },
              "live": {
                "type": "string"
              },
              "ready": {
                "type": "string"
              },
              "health": {
                "type": "string"
              }
            }
          },
          "hard_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "soft_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "check_timeout_ms": {
            "type": "integer",
            "minimum": 0
          },
          "cache_ms": {
            "type": "integer",
            "minimum": 0
          },
          "max_concurrent_checks": {
            "type": "integer",
            "minimum": 0
          },
          "shutdown_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "stop_grace_seconds": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "env_example": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "type",
          "sensitive"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "sensitive": {
            "type": "boolean"
          }
        }
      }
    },
    "plugin_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog",
        "validator",
        "health_path",
        "metrics_path"
      ],
      "properties": {
        "catalog": {
          "type": "string"
        },
        "validator": {
          "type": "string"
        },
        "health_path": {
          "type": "string"
        },
        "metrics_path": {
          "type": "string"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

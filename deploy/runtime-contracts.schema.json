{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "product_version",
    "platform",
    "components",
    "env_example",
    "plugin_manifest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "1"
    },
    "product_version": {
      "type": "string"
    },
    "platform": {
      "const": "linux/amd64"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "module",
          "entrypoint",
          "configuration",
          "compose_service",
          "plugin_id",
          "environment",
          "listeners",
          "probes",
          "hard_dependencies",
          "soft_dependencies",
          "check_timeout_ms",
          "cache_ms",
          "max_concurrent_checks",
          "shutdown_seconds",
          "stop_grace_seconds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "entrypoint": {
            "type": "string"
          },
          "configuration": {
            "type": "string"
          },
          "compose_service": {
            "type": [
              "string",
              "null"
            ]
          },
          "plugin_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "environment": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "type",
                "sensitive",
                "required",
                "default",
                "compose_value",
                "aliases"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "string",
                    "integer",
                    "boolean",
                    "duration",
                    "host",
                    "url"
                  ]
                },
                "sensitive": {
                  "type": "boolean"
                },
                "required": {
                  "type": "boolean"
                },
                "default": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "compose_value": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "aliases": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "key",
                      "expires"
                    ],
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "expires": {
                        "type": "string",
                        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                      }
                    }
                  }
                }
              }
            }
          },
          "listeners": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "port",
                "scope"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "port": {
                  "type": "integer",
                  "minimum": 0
                },
                "scope": {
                  "type": "string"
                }
              }
            }
          },
          "probes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startup",
              "live",
              "ready",
              "health"
            ],
            "properties": {
              "startup": {
                "type": "string"
              },
              "live": {
                "type": "string"
              },
              "ready": {
                "type": "string"
              },
              "health": {
                "type": "string"
              }
            }
          },
          "hard_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "soft_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "check_timeout_ms": {
            "type": "integer",
            "minimum": 0
          },
          "cache_ms": {
            "type": "integer",
            "minimum": 0
          },
          "max_concurrent_checks": {
            "type": "integer",
            "minimum": 0
          },
          "shutdown_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "stop_grace_seconds": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "env_example": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "type",
          "sensitive"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "sensitive": {
            "type": "boolean"
          }
        }
      }
    },
    "plugin_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog",
        "validator",
        "health_path",
        "metrics_path"
      ],
      "properties": {
        "catalog": {
          "type": "string"
        },
        "validator": {
          "type": "string"
        },
        "health_path": {
          "type": "string"
        },
        "metrics_path": {
          "type": "string"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "selfmonitor-grafana",
              "app.kubernetes.io/part-of": "gopulse"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "grafana",
                "image": "grafana/grafana:12.1.1@sha256:a1701c2180249361737a99a01bc770db39381640e4d631825d38ff4535efa47d",
                "ports": [
                  {
                    "containerPort": 3000
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/grafana"
                  },
                  {
                    "name": "grafana-datasource",
                    "mountPath": "/etc/grafana/provisioning/datasources/default.yaml",
                    "subPath": "datasource.yaml",
                    "readOnly": true
                  },
                  {
                    "name": "grafana-provider",
                    "mountPath": "/etc/grafana/provisioning/dashboards/default.yaml",
                    "subPath": "provider.yaml",
                    "readOnly": true
                  },
                  {
                    "name": "grafana-dashboard",
                    "mountPath": "/var/lib/grafana/dashboards/gopulse.json",
                    "subPath": "gopulse.json",
                    "readOnly": true
                  }
                ],
                "env": [
                  {
                    "name": "GF_SECURITY_ADMIN_USER",
                    "value": "admin"
                  },
                  {
                    "name": "GF_SECURITY_ADMIN_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "selfmonitor-credentials",
                        "key": "GRAFANA_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "GF_USERS_ALLOW_SIGN_UP",
                    "value": "false"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/api/health",
                    "port": 3000
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10
                }
              }
            ],
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 30,
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "selfmonitor-grafana-data"
                }
              },
              {
                "name": "grafana-datasource",
                "configMap": {
                  "name": "selfmonitor-grafana"
                }
              },
              {
                "name": "grafana-provider",
                "configMap": {
                  "name": "selfmonitor-grafana"
                }
              },
              {
                "name": "grafana-dashboard",
                "configMap": {
                  "name": "selfmonitor-grafana"
                }
              }
            ],
            "securityContext": {
              "fsGroup": 472
            }
          }
        },
        "replicas": 1,
        "serviceName": "selfmonitor-grafana"
      }

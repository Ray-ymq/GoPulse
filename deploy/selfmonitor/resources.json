  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "selfmonitor-prometheus-data",
        "labels": {
          "app.kubernetes.io/name": "selfmonitor-prometheus-data",
          "app.kubernetes.io/part-of": "gopulse"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "local-path",
        "resources": {
          "requests": {
            "storage": "4Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "selfmonitor-prometheus",
        "labels": {
          "app.kubernetes.io/name": "selfmonitor-prometheus",
          "app.kubernetes.io/part-of": "gopulse"
        }
      },
      "spec": {
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "selfmonitor-prometheus"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "selfmonitor-prometheus",
              "app.kubernetes.io/part-of": "gopulse"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "prometheus",
                "image": "prom/prometheus:v3.5.0@sha256:63805ebb8d2b3920190daf1cb14a60871b16fd38bed42b857a3182bc621f4996",
                "ports": [
                  {
                    "containerPort": 9090
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/prometheus"
                  },
                  {
                    "name": "config",
                    "mountPath": "/etc/prometheus",
                    "readOnly": true
                  },
                  {
                    "name": "tokens",
                    "mountPath": "/etc/prometheus/secrets",
                    "readOnly": true
                  }
                ],
                "args": [
                  "--config.file=/etc/prometheus/prometheus.yaml",
                  "--storage.tsdb.path=/prometheus",
                  "--storage.tsdb.retention.time=15d"
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/-/ready",
                    "port": 9090
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10
                }
              }
            ],
            "automountServiceAccountToken": true,
            "terminationGracePeriodSeconds": 30,
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "selfmonitor-prometheus-data"
                }
              },
              {
                "name": "config",
                "configMap": {
                  "name": "selfmonitor-prometheus"
                }
              },
              {
                "name": "tokens",
                "secret": {
                  "secretName": "gopulse-credentials",
                  "items": [
                    {
                      "key": "BACKEND_METRICS_TOKEN",
                      "path": "backend_token"
                    },
                    {
                      "key": "BUSINESS_WORKER_METRICS_TOKEN",
                      "path": "business-worker_token"
                    },
                    {
                      "key": "SEARCH_INDEXER_METRICS_TOKEN",
                      "path": "search-indexer_token"
                    },
                    {
                      "key": "MONITOR_METRICS_TOKEN",
                      "path": "monitor_token"
                    },
                    {
                      "key": "MARSHALLER_METRICS_TOKEN",
                      "path": "marshaller_token"
                    },
                    {
                      "key": "VICTORIAMETRICS_PASSWORD",
                      "path": "vm_password"
                    }
                  ]
                }
              }
            ],
            "securityContext": {
              "fsGroup": 65534
            },
            "serviceAccountName": "selfmonitor"
          }
        },
        "replicas": 1,
        "serviceName": "selfmonitor-prometheus"
      }
    },
    {
      "apiVersion": "v1",

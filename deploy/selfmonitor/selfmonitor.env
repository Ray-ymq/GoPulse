# Fixed non-secret configuration for this Linux host.
GRAFANA_ROOT_URL=http://localhost:23000/
GRAFANA_ADMIN_USER=selfmonitor-admin
GOPULSE_BUSINESS_NETWORK=gopulse_business
GOPULSE_OBSERVABILITY_NETWORK=gopulse_observability
# Product release used by the current-host launcher.
GOPULSE_VERSION=2.6.5
# Override obsolete topic/group names in older local .env files.
MARSHALLER_KAFKA_TOPIC=gopulse-observability-metrics
MARSHALLER_KAFKA_GROUP=gopulse-marshaller-metrics

# Include in the HOST HTTPS site server. Grafana authenticates independently.
# For a containerized edge, run a host reverse proxy in front of the product;
# the product edge container cannot reach the host's loopback address.
location = /grafana { return 308 /grafana/; }
location ^~ /grafana/ {
    proxy_pass http://127.0.0.1:13000;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 60s;
}

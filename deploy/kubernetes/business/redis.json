{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "redis-env",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "redis-env"
        }
      },
      "data": {
        "REDIS_MAXMEMORY": "256mb",
        "REDIS_MAXMEMORY_POLICY": "noeviction"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "redis",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "redis"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "redis"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "redis",
              "app.kubernetes.io/part-of": "gopulse"
            }
          },
          "spec": {
            "terminationGracePeriodSeconds": 30,
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "redis",
                "image": "redis:7.2.5-alpine",
                "imagePullPolicy": "IfNotPresent",
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "redis-env"
                    }
                  },
                  {
                    "configMapRef": {
                      "name": "gopulse-identity"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "REDISCLI_AUTH",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "gopulse-credentials",
                        "key": "REDIS_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "REDIS_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "gopulse-credentials",
                        "key": "REDIS_PASSWORD"
                      }
                    }
                  }
                ],
                "command": [
                  "sh",
                  "-ec",
                  "umask 077\nif [ ! -s /data/users.acl ]; then printf 'user default on >%s ~* &* +@all\\n' \"$REDIS_PASSWORD\" > /data/users.acl; fi\nexec redis-server --appendonly yes --aclfile /data/users.acl --maxmemory \"$REDIS_MAXMEMORY\" --maxmemory-policy \"$REDIS_MAXMEMORY_POLICY\""
                ],
                "ports": [
                  {
                    "containerPort": 6379,
                    "name": "p6379"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "384Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "redis-data",
                    "mountPath": "/data"
                  }
                ],
                "startupProbe": {
                  "tcpSocket": {
                    "port": 6379
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 60
                },
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 6379
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "tcpSocket": {
                    "port": 6379
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        },
        "serviceName": "redis",
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "redis-data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "storageClassName": "local-path",
              "resources": {
                "requests": {
                  "storage": "8Gi"
                }
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "redis",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "redis"
        }
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "redis"
        },
        "ports": [
          {
            "port": 6379,
            "targetPort": 6379,
            "name": "p6379"
          }
        ]
      }
    }
  ]
}

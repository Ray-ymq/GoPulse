{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "backend-env",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "backend-env"
        }
      },
      "data": {
        "APP_ENV": "development",
        "AUTH_COOKIE_NAME": "gopulse_session",
        "AUTH_COOKIE_SECURE": "false",
        "AUTH_JWT_TTL": "2h",
        "BACKEND_ENDPOINTS": "backend,platform-api",
        "BACKEND_HTTP_MAX_CONCURRENCY": "128",
        "BACKEND_LOG_READ_ALIAS": "gopulse-logs-v1-read",
        "BACKEND_RATE_LIMIT_ENABLED": "true",
        "BACKEND_RATE_LIMIT_LOCAL_MAX_IDENTITIES": "1024",
        "BACKEND_RATE_LIMIT_OPERATION_TIMEOUT": "200ms",
        "BACKEND_RESOURCE_AUTH": "16",
        "BACKEND_RESOURCE_DATABASE": "32",
        "BACKEND_RESOURCE_READ": "64",
        "BACKEND_RESOURCE_REBUILD": "8",
        "BACKEND_RESOURCE_WAITER": "256",
        "BACKEND_RESOURCE_WRITE": "32",
        "BACKEND_SERVICE_ROLE": "business",
        "BACKEND_TRUSTED_PROXY_CIDRS": "",
        "BUSINESS_ASYNC_MAX_OPEN_REQUIREMENTS": "10000",
        "BUSINESS_ASYNC_MAX_RETAINED_BYTES": "1073741824",
        "BUSINESS_ASYNC_MAX_RETAINED_GROUPS": "100000",
        "BUSINESS_WORKER_ENDPOINTS": "business-worker",
        "ELASTICSEARCH_REQUEST_TIMEOUT": "3s",
        "ELASTICSEARCH_URL": "http://elasticsearch:9200",
        "GOPULSE_REPLICA_COUNT": "1",
        "GOPULSE_RUNTIME_MODE": "container",
        "GOPULSE_TRACE_BATCH_SIZE": "256",
        "GOPULSE_TRACE_BATCH_TIMEOUT": "1s",
        "GOPULSE_TRACE_ENABLED": "false",
        "GOPULSE_TRACE_ENDPOINT": "",
        "GOPULSE_TRACE_EXPORT_TIMEOUT": "2s",
        "GOPULSE_TRACE_QUEUE_CAPACITY": "2048",
        "GOPULSE_TRACE_SAMPLE_RATIO": "0.10",
        "GOPULSE_TRACE_SERVICE_NAME": "backend",
        "GOPULSE_TRACE_SHUTDOWN_TIMEOUT": "5s",
        "HTTP_HOST": "0.0.0.0",
        "HTTP_PORT": "8080",
        "LOG_MONITOR_URL": "http://monitor:9090",
        "MARSHALLER_ENDPOINTS": "marshaller",
        "MYSQL_CONN_MAX_LIFETIME": "3m",
        "MYSQL_DATABASE": "gopulse",
        "MYSQL_HOST": "mysql",
        "MYSQL_MAX_IDLE_CONNS": "2",
        "MYSQL_MAX_OPEN_CONNS": "8",
        "MYSQL_PORT": "3306",
        "MYSQL_TOTAL_MAX_OPEN_CONNS": "60",
        "MYSQL_USER": "gopulse",
        "OUTBOX_CLAIM_BATCH": "50",
        "OUTBOX_CLEANUP_BATCH": "500",
        "OUTBOX_CLEANUP_INTERVAL": "1h",
        "OUTBOX_DATABASE_TIMEOUT": "2s",
        "OUTBOX_LEASE_DURATION": "5m",
        "OUTBOX_MYSQL_MAX_OPEN_CONNS": "4",
        "OUTBOX_POLL_INTERVAL": "1s",
        "OUTBOX_PUBLISHED_RETENTION": "168h",
        "OUTBOX_PUBLISH_CONCURRENCY": "8",
        "OUTBOX_PUBLISH_TIMEOUT": "5s",
        "OUTBOX_RETRY_DELAY": "30s",
        "REDIS_DB": "0",
        "REDIS_HOST": "redis",
        "REDIS_OPERATION_TIMEOUT": "200ms",
        "REDIS_POOL_SIZE": "16",
        "REDIS_POOL_TIMEOUT": "200ms",
        "REDIS_PORT": "6379",
        "REDIS_POST_DETAIL_TTL": "5m",
        "SEARCH_INDEXER_ENDPOINTS": "search-indexer",
        "SEARCH_INDEXER_RETRY_DELAY": "30s"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "backend",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "backend"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "backend"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "backend",
              "app.kubernetes.io/part-of": "gopulse"
            }
          },
          "spec": {
            "terminationGracePeriodSeconds": 30,
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "backend",
                "image": "gopulse/backend:local",
                "imagePullPolicy": "IfNotPresent",
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "backend-env"
                    }
                  },
                  {
                    "configMapRef": {
                      "name": "gopulse-identity"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "AUTH_JWT_SECRET",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "gopulse-credentials",
                        "key": "AUTH_JWT_SECRET"
                      }
                    }
                  },
                  {
                    "name": "BACKEND_METRICS_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "gopulse-credentials",
                        "key": "BACKEND_METRICS_TOKEN"
                      }
                    }
                  },
                  {
                    "name": "BUSINESS_STAGE_SERVICE_CREDENTIAL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "gopulse-credentials",
                        "key": "BUSINESS_STAGE_SERVICE_CREDENTIAL"
                      }
                    }
                  },
                  {
                    "name": "LOG_MONITOR_INGEST_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "gopulse-credentials",
                        "key": "LOG_MONITOR_INGEST_TOKEN"
                      }
                    }
                  },
                  {
                    "name": "MYSQL_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "gopulse-credentials",
                        "key": "MYSQL_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "RABBITMQ_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "gopulse-credentials",
                        "key": "RABBITMQ_URL"
                      }
                    }
                  },
                  {
                    "name": "REDIS_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "gopulse-credentials",
                        "key": "REDIS_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "GOPULSE_INSTANCE_ID",
                    "value": "backend-1"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 8080,
                    "name": "p8080"
                  },
                  {
                    "containerPort": 19101,
                    "name": "p19101"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1000m",
                    "memory": "256Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "startupProbe": {
                  "httpGet": {
                    "path": "/startup",
                    "port": 8080
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 60
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": 8080
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/live",
                    "port": 8080
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        },
        "strategy": {
          "type": "Recreate"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "backend",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "backend"
        }
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "backend"
        },
        "ports": [
          {
            "port": 8080,
            "targetPort": 8080,
            "name": "p8080"
          },
          {
            "port": 19101,
            "targetPort": 19101,
            "name": "p19101"
          }
        ]
      }
    }
  ]
}

{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "elasticsearch-env",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "elasticsearch-env"
        }
      },
      "data": {
        "ES_JAVA_OPTS": "-Xms512m -Xmx512m",
        "discovery.type": "single-node",
        "xpack.security.enabled": "false",
        "xpack.security.enrollment.enabled": "false"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "elasticsearch",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "elasticsearch"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "elasticsearch"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "elasticsearch",
              "app.kubernetes.io/part-of": "gopulse"
            }
          },
          "spec": {
            "terminationGracePeriodSeconds": 30,
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "elasticsearch",
                "image": "docker.elastic.co/elasticsearch/elasticsearch:9.5.2",
                "imagePullPolicy": "IfNotPresent",
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "elasticsearch-env"
                    }
                  },
                  {
                    "configMapRef": {
                      "name": "gopulse-identity"
                    }
                  }
                ],
                "env": [],
                "ports": [
                  {
                    "containerPort": 9200,
                    "name": "p9200"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "768Mi"
                  },
                  "limits": {
                    "cpu": "2000m",
                    "memory": "1536Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "elasticsearch-data",
                    "mountPath": "/usr/share/elasticsearch/data"
                  }
                ],
                "startupProbe": {
                  "tcpSocket": {
                    "port": 9200
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 60
                },
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 9200
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "tcpSocket": {
                    "port": 9200
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ],
            "securityContext": {
              "fsGroup": 1000
            }
          }
        },
        "serviceName": "elasticsearch",
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "elasticsearch-data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "storageClassName": "local-path",
              "resources": {
                "requests": {
                  "storage": "8Gi"
                }
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "elasticsearch",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "elasticsearch"
        }
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "elasticsearch"
        },
        "ports": [
          {
            "port": 9200,
            "targetPort": 9200,
            "name": "p9200"
          }
        ]
      }
    }
  ]
}

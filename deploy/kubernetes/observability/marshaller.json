{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "marshaller-env",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "marshaller-env"
        }
      },
      "data": {
        "GOPULSE_REPLICA_COUNT": "1",
        "GOPULSE_RUNTIME_MODE": "container",
        "MARSHALLER_ELASTICSEARCH_TIMEOUT": "3s",
        "MARSHALLER_ELASTICSEARCH_URL": "http://observability-elasticsearch:9200",
        "MARSHALLER_EVENT_INDEX_PREFIX": "gopulse-events-v1-",
        "MARSHALLER_EVENT_RETENTION_DAYS": "7",
        "MARSHALLER_EVENT_TEMPLATE": "gopulse-events-v1-template",
        "MARSHALLER_FUTURE_SKEW": "5m",
        "MARSHALLER_HTTP_HOST": "0.0.0.0",
        "MARSHALLER_HTTP_PORT": "9093",
        "MARSHALLER_KAFKA_BROKERS": "kafka:19092",
        "MARSHALLER_KAFKA_COMMIT_TIMEOUT": "3s",
        "MARSHALLER_KAFKA_GROUP": "gopulse-marshaller-metrics",
        "MARSHALLER_KAFKA_MIN_PARTITIONS": "4",
        "MARSHALLER_KAFKA_TOPIC": "gopulse-observability-metrics",
        "MARSHALLER_LOG_INDEX_PREFIX": "gopulse-logs-v1-",
        "MARSHALLER_LOG_RETENTION_DAYS": "7",
        "MARSHALLER_LOG_TEMPLATE": "gopulse-logs-v1-template",
        "MARSHALLER_MAX_IN_FLIGHT": "4",
        "MARSHALLER_MAX_RETRYING": "4",
        "MARSHALLER_READINESS_TIMEOUT": "2s",
        "MARSHALLER_RETENTION_BATCH_INDICES": "16",
        "MARSHALLER_RETENTION_CATCHUP_DEADLINE": "60s",
        "MARSHALLER_RETENTION_CYCLE": "60s",
        "MARSHALLER_RETENTION_MAX_RETRIES": "3",
        "MARSHALLER_RETENTION_REQUEST_TIMEOUT": "3s",
        "MARSHALLER_RETENTION_RETRY_MAX": "5s",
        "MARSHALLER_RETENTION_RETRY_MIN": "250ms",
        "MARSHALLER_RETENTION_ROUND_TIMEOUT": "15s",
        "MARSHALLER_RETRY_MAX": "5s",
        "MARSHALLER_RETRY_MIN": "250ms",
        "MARSHALLER_SHUTDOWN_TIMEOUT": "10s",
        "MARSHALLER_VM_TIMEOUT": "3s",
        "MARSHALLER_VM_URL": "http://victoriametrics:8428",
        "MARSHALLER_VM_USERNAME": "gopulse-marshaller"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "marshaller",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "marshaller"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "marshaller"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "marshaller",
              "app.kubernetes.io/part-of": "gopulse"
            }
          },
          "spec": {
            "terminationGracePeriodSeconds": 30,
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "marshaller",
                "image": "gopulse/marshaller:local",
                "imagePullPolicy": "IfNotPresent",
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "marshaller-env"
                    }
                  },
                  {
                    "configMapRef": {
                      "name": "gopulse-identity"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "MARSHALLER_API_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "gopulse-credentials",
                        "key": "MARSHALLER_API_TOKEN"
                      }
                    }
                  },
                  {
                    "name": "MARSHALLER_METRICS_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "gopulse-credentials",
                        "key": "MARSHALLER_METRICS_TOKEN"
                      }
                    }
                  },
                  {
                    "name": "MARSHALLER_VM_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "gopulse-credentials",
                        "key": "VICTORIAMETRICS_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "GOPULSE_INSTANCE_ID",
                    "value": "marshaller-1"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 9093,
                    "name": "p9093"
                  },
                  {
                    "containerPort": 19106,
                    "name": "p19106"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1000m",
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "startupProbe": {
                  "httpGet": {
                    "path": "/startup",
                    "port": 9093
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 60
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": 9093
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/live",
                    "port": 9093
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        },
        "strategy": {
          "type": "Recreate"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "marshaller",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "marshaller"
        }
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "marshaller"
        },
        "ports": [
          {
            "port": 9093,
            "targetPort": 9093,
            "name": "p9093"
          },
          {
            "port": 19106,
            "targetPort": 19106,
            "name": "p19106"
          }
        ]
      }
    }
  ]
}

{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "kafka-init-env",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "kafka-init-env"
        }
      },
      "data": {
        "KAFKA_HEAP_OPTS": "-Xms64m -Xmx128m"
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "kafka-init",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "kafka-init"
        }
      },
      "spec": {
        "backoffLimit": 5,
        "activeDeadlineSeconds": 600,
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "kafka-init",
              "app.kubernetes.io/part-of": "gopulse"
            }
          },
          "spec": {
            "terminationGracePeriodSeconds": 30,
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "kafka-init",
                "image": "apache/kafka:4.3.1",
                "imagePullPolicy": "IfNotPresent",
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "kafka-init-env"
                    }
                  },
                  {
                    "configMapRef": {
                      "name": "gopulse-identity"
                    }
                  }
                ],
                "env": [],
                "command": [
                  "/bin/bash",
                  "-ec",
                  "for topic in gopulse-observability-metrics gopulse-observability-logs gopulse-observability-events; do /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:19092 --create --if-not-exists --topic \"${topic}\" --partitions 4 --replication-factor 1 --config cleanup.policy=delete --config retention.ms=259200000 --config retention.bytes=2147483648 --config segment.bytes=67108864 --config segment.ms=3600000; /opt/kafka/bin/kafka-configs.sh --bootstrap-server kafka:19092 --alter --entity-type topics --entity-name \"${topic}\" --add-config cleanup.policy=delete,retention.ms=259200000,retention.bytes=2147483648,segment.bytes=67108864,segment.ms=3600000; /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:19092 --describe --topic \"${topic}\"; done"
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1000m",
                    "memory": "256Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ],
            "restartPolicy": "Never"
          }
        }
      }
    }
  ]
}

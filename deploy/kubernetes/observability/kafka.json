{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "kafka-env",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "kafka-env"
        }
      },
      "data": {
        "KAFKA_ADVERTISED_LISTENERS": "INTERNAL://kafka:19092",
        "KAFKA_AUTO_CREATE_TOPICS_ENABLE": "false",
        "KAFKA_CONTROLLER_LISTENER_NAMES": "CONTROLLER",
        "KAFKA_CONTROLLER_QUORUM_VOTERS": "1@kafka:9093",
        "KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS": "0",
        "KAFKA_INTER_BROKER_LISTENER_NAME": "INTERNAL",
        "KAFKA_LISTENERS": "CONTROLLER://:9093,INTERNAL://:19092",
        "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP": "CONTROLLER:PLAINTEXT,INTERNAL:PLAINTEXT",
        "KAFKA_LOG_DIRS": "/var/lib/kafka/data",
        "KAFKA_LOG_RETENTION_BYTES": "2147483648",
        "KAFKA_LOG_RETENTION_MS": "259200000",
        "KAFKA_LOG_SEGMENT_BYTES": "67108864",
        "KAFKA_LOG_SEGMENT_MS": "3600000",
        "KAFKA_NODE_ID": "1",
        "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR": "1",
        "KAFKA_PROCESS_ROLES": "broker,controller",
        "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR": "1",
        "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR": "1",
        "KAFKA_HEAP_OPTS": "-Xms256m -Xmx512m",
        "CLUSTER_ID": "MkU3OEVBNTcwNTJENDM2Qk"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "kafka",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "kafka"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "kafka"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "kafka",
              "app.kubernetes.io/part-of": "gopulse"
            }
          },
          "spec": {
            "terminationGracePeriodSeconds": 30,
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "kafka",
                "image": "apache/kafka:4.3.1",
                "imagePullPolicy": "IfNotPresent",
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "kafka-env"
                    }
                  },
                  {
                    "configMapRef": {
                      "name": "gopulse-identity"
                    }
                  }
                ],
                "env": [],
                "ports": [
                  {
                    "containerPort": 19092,
                    "name": "p19092"
                  },
                  {
                    "containerPort": 9093,
                    "name": "p9093"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "512Mi"
                  },
                  "limits": {
                    "cpu": "1500m",
                    "memory": "1024Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "kafka-data",
                    "mountPath": "/var/lib/kafka/data"
                  }
                ],
                "startupProbe": {
                  "tcpSocket": {
                    "port": 19092
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 60
                },
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 19092
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "tcpSocket": {
                    "port": 19092
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ],
            "securityContext": {
              "fsGroup": 1000
            }
          }
        },
        "serviceName": "kafka",
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "kafka-data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "storageClassName": "local-path",
              "resources": {
                "requests": {
                  "storage": "8Gi"
                }
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "kafka",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "kafka"
        }
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "kafka"
        },
        "ports": [
          {
            "port": 19092,
            "targetPort": 19092,
            "name": "p19092"
          },
          {
            "port": 9093,
            "targetPort": 9093,
            "name": "p9093"
          }
        ],
        "publishNotReadyAddresses": true
      }
    }
  ]
}

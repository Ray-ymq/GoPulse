{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "victoriametrics-env",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "victoriametrics-env"
        }
      },
      "data": {
        "VICTORIAMETRICS_USERNAME": "gopulse-marshaller"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "victoriametrics",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "victoriametrics"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "victoriametrics"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "victoriametrics",
              "app.kubernetes.io/part-of": "gopulse"
            }
          },
          "spec": {
            "terminationGracePeriodSeconds": 30,
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "victoriametrics",
                "image": "victoriametrics/victoria-metrics:v1.151.0",
                "imagePullPolicy": "IfNotPresent",
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "victoriametrics-env"
                    }
                  },
                  {
                    "configMapRef": {
                      "name": "gopulse-identity"
                    }
                  }
                ],
                "env": [],
                "ports": [
                  {
                    "containerPort": 8428,
                    "name": "p8428"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1000m",
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "victoriametrics-data",
                    "mountPath": "/victoria-metrics-data"
                  },
                  {
                    "name": "vm-auth",
                    "mountPath": "/run/secrets",
                    "readOnly": true
                  }
                ],
                "startupProbe": {
                  "tcpSocket": {
                    "port": 8428
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 60
                },
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 8428
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "tcpSocket": {
                    "port": 8428
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                },
                "args": [
                  "-storageDataPath=/victoria-metrics-data",
                  "-httpAuth.username=gopulse-marshaller",
                  "-httpAuth.password=file:///run/secrets/victoriametrics_password",
                  "-dedup.minScrapeInterval=1ms",
                  "-retentionPeriod=30d"
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              },
              {
                "name": "vm-auth",
                "secret": {
                  "secretName": "gopulse-credentials",
                  "items": [
                    {
                      "key": "VICTORIAMETRICS_PASSWORD",
                      "path": "victoriametrics_password"
                    }
                  ]
                }
              }
            ]
          }
        },
        "serviceName": "victoriametrics",
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "victoriametrics-data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "storageClassName": "local-path",
              "resources": {
                "requests": {
                  "storage": "8Gi"
                }
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "victoriametrics",
        "labels": {
          "app.kubernetes.io/part-of": "gopulse",
          "app.kubernetes.io/name": "victoriametrics"
        }
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "victoriametrics"
        },
        "ports": [
          {
            "port": 8428,
            "targetPort": 8428,
            "name": "p8428"
          }
        ]
      }
    }
  ]
}

# GoPulse local development defaults.
# These credentials are intentionally development-only and must not be reused in production.

APP_ENV=development
# Loopback is the safe default. Set these explicitly only when remote access is required.
PUBLISHED_HOST=127.0.0.1
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
FRONTEND_PORT=5173

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gopulse
MYSQL_USER=gopulse
MYSQL_PASSWORD=gopulse-mysql
MYSQL_ROOT_PASSWORD=gopulse-root

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=gopulse-redis
REDIS_DB=0
REDIS_EXPORTER_HTTP_HOST=127.0.0.1
REDIS_EXPORTER_HTTP_PORT=9121
REDIS_EXPORTER_SCRAPE_TIMEOUT=2s
REDIS_EXPORTER_SHUTDOWN_TIMEOUT=5s

RABBITMQ_USER=gopulse
RABBITMQ_PASSWORD=gopulse-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://gopulse:gopulse-rabbitmq@127.0.0.1:5672/

# Phase 7 local Kafka and Message Router settings. The token is development-only; replace it outside local development.
KAFKA_PORT=9092
ROUTER_HTTP_HOST=127.0.0.1
ROUTER_HTTP_PORT=9091
ROUTER_API_TOKEN=local-router-api-token-change-me-32-bytes
ROUTER_REQUEST_TIMEOUT=5s
ROUTER_SHUTDOWN_TIMEOUT=10s
ROUTER_MAX_MESSAGE_BYTES=1048576
ROUTER_KAFKA_BROKERS=127.0.0.1:9092
ROUTER_KAFKA_TOPIC=gopulse-observability-v1
ROUTER_KAFKA_PRODUCE_TIMEOUT=3s
ROUTER_KAFKA_MAX_BUFFERED_RECORDS=256
ROUTER_KAFKA_MAX_BUFFERED_BYTES=8388608

# Phase 8 local Marshaller and VictoriaMetrics settings. Replace both development credentials outside local development.
VICTORIAMETRICS_PORT=8428
VICTORIAMETRICS_USERNAME=gopulse-marshaller
VICTORIAMETRICS_PASSWORD=local-victoriametrics-password32
MARSHALLER_HTTP_HOST=127.0.0.1
MARSHALLER_HTTP_PORT=9093
MARSHALLER_API_TOKEN=local-marshaller-api-token-change-me-32-bytes
MARSHALLER_KAFKA_BROKERS=127.0.0.1:9092
MARSHALLER_KAFKA_TOPIC=gopulse-observability-v1
MARSHALLER_KAFKA_GROUP=gopulse-marshaller-metrics-v1
MARSHALLER_KAFKA_COMMIT_TIMEOUT=3s
MARSHALLER_VM_URL=http://127.0.0.1:8428
MARSHALLER_VM_USERNAME=gopulse-marshaller
MARSHALLER_VM_PASSWORD=local-victoriametrics-password32
MARSHALLER_VM_TIMEOUT=3s
MARSHALLER_ELASTICSEARCH_URL=http://127.0.0.1:9200
MARSHALLER_ELASTICSEARCH_TIMEOUT=3s
MARSHALLER_LOG_TEMPLATE=gopulse-logs-v1-template
MARSHALLER_LOG_INDEX_PREFIX=gopulse-logs-v1-
MARSHALLER_EVENT_TEMPLATE=gopulse-events-v1-template
MARSHALLER_EVENT_INDEX_PREFIX=gopulse-events-v1-
MARSHALLER_RETRY_MIN=250ms
MARSHALLER_RETRY_MAX=5s
MARSHALLER_READINESS_TIMEOUT=2s
MARSHALLER_SHUTDOWN_TIMEOUT=10s
MARSHALLER_FUTURE_SKEW=5m

# Phase 3 local Elasticsearch and historical reindex settings.
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_REQUEST_TIMEOUT=3s
SEARCH_REINDEX_BATCH=500

# Phase 2 transactional Outbox dispatcher settings.
OUTBOX_POLL_INTERVAL=1s
OUTBOX_CLAIM_BATCH=10
OUTBOX_LEASE_DURATION=1m
OUTBOX_PUBLISH_TIMEOUT=5s
OUTBOX_RETRY_DELAY=30s
OUTBOX_CLEANUP_INTERVAL=1h
OUTBOX_PUBLISHED_RETENTION=168h
OUTBOX_CLEANUP_BATCH=500

# Phase 2 Business Worker settings. OUTBOX_RETRY_DELAY is also the shared
# durable retry-queue TTL and must therefore match in Backend and Worker.
BUSINESS_WORKER_PREFETCH=10
BUSINESS_WORKER_MAX_RETRIES=3
BUSINESS_WORKER_PUBLISH_TIMEOUT=5s
BUSINESS_WORKER_SHUTDOWN_TIMEOUT=10s
BUSINESS_WORKER_RECONNECT_MIN=500ms
BUSINESS_WORKER_RECONNECT_MAX=30s

# Phase 3 Search Indexer settings. The dedicated retry topology is isolated
# from notification delivery and is declared with this TTL by both Backend and Indexer.
SEARCH_INDEXER_PREFETCH=10
SEARCH_INDEXER_MAX_RETRIES=3
SEARCH_INDEXER_RETRY_DELAY=30s
SEARCH_INDEXER_PUBLISH_TIMEOUT=5s
SEARCH_INDEXER_SHUTDOWN_TIMEOUT=10s
SEARCH_INDEXER_RECONNECT_MIN=500ms
SEARCH_INDEXER_RECONNECT_MAX=30s

# Phase 1 authentication and cache settings.
# Development-only example secret: replace it locally and never reuse it outside local development.
AUTH_JWT_SECRET=local-development-jwt-secret-32-bytes-minimum
AUTH_JWT_TTL=2h
AUTH_COOKIE_NAME=gopulse_session
# Local HTTP development may use false; non-local environments must set this to true.
AUTH_COOKIE_SECURE=false
MONITOR_URL=http://127.0.0.1:9090
MONITOR_HTTP_HOST=127.0.0.1
MONITOR_HTTP_PORT=9090
MONITOR_API_TOKEN=local-monitor-api-token-change-me-32-bytes
LOG_MONITOR_INGEST_TOKEN=local-log-ingest-token-change-me-32-bytes
LOG_MONITOR_URL=http://127.0.0.1:9090
LOG_SHIP_REQUEST_TIMEOUT=2s
LOG_SHIP_QUEUE_CAPACITY=256
LOG_SHIP_RETRY_MIN=250ms
LOG_SHIP_RETRY_MAX=5s
LOG_SHIP_SHUTDOWN_TIMEOUT=5s
MONITOR_LOG_MAX_BYTES=65536
MONITOR_LOG_FUTURE_SKEW=5m
MONITOR_EVENT_QUEUE_CAPACITY=256
MONITOR_EVENT_RETRY_MIN=250ms
MONITOR_EVENT_RETRY_MAX=5s
MONITOR_EVENT_SHUTDOWN_TIMEOUT=5s
MONITOR_EVENT_MAX_BYTES=16384
BACKEND_VICTORIAMETRICS_URL=http://127.0.0.1:8428
BACKEND_VICTORIAMETRICS_USERNAME=gopulse-marshaller
BACKEND_VICTORIAMETRICS_PASSWORD=local-victoriametrics-password32
BACKEND_VICTORIAMETRICS_QUERY_TIMEOUT=3s
BACKEND_METRIC_QUERY_DEFAULT_RANGE=15m
BACKEND_METRIC_QUERY_MAX_RANGE=24h
BACKEND_LOG_READ_ALIAS=gopulse-logs-v1-read
BACKEND_LOG_QUERY_DEFAULT_RANGE=15m
BACKEND_LOG_QUERY_MAX_RANGE=24h
BACKEND_EVENT_READ_ALIAS=gopulse-events-v1-read
BACKEND_EVENT_QUERY_DEFAULT_RANGE=15m
BACKEND_EVENT_QUERY_MAX_RANGE=24h
MONITOR_REQUEST_TIMEOUT=30s
MONITOR_SHUTDOWN_TIMEOUT=10s
MONITOR_PLUGIN_STARTUP_TIMEOUT=10s
MONITOR_PLUGIN_STOP_TIMEOUT=5s
MONITOR_SCRAPE_INTERVAL=15s
MONITOR_SCRAPE_TIMEOUT=3s
MONITOR_PUBLISH_TIMEOUT=3s
MONITOR_ROUTER_URL=http://127.0.0.1:9091
MONITOR_ROUTER_TOKEN=local-router-api-token-change-me-32-bytes
REDIS_POST_DETAIL_TTL=5m
REDIS_OPERATION_TIMEOUT=200ms

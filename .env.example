# GoPulse local development defaults.
# These credentials are intentionally development-only and must not be reused in production.

APP_ENV=development
GOPULSE_RUNTIME_MODE=host
GOPULSE_VERSION=2.6.5
GOPULSE_REVISION=development
# One-shot lifecycle restore preparation inputs; leave empty for normal startup.
GOPULSE_RESTORE_OPERATION=
GOPULSE_RESTORE_EXPECTED_OLD_EPOCH=
GOPULSE_RESTORE_NEW_EPOCH=
GOPULSE_INSTANCE_ID=backend-local
GOPULSE_REPLICA_COUNT=1
BACKEND_SERVICE_ROLE=business
# Trace is disabled for normal development. Phase-20 acceptance overlays the
# private Collector and raises only its controlled flow to a 100% sample rate.
# Backend requests and MySQL pools are bounded per process. The total limit
# covers the planned business replicas without allowing an unbounded fan-out.
BACKEND_HTTP_MAX_CONCURRENCY=128
# Phase 1/2 protection is enabled by default after the R09 and business
# acceptance gates. Set either flag to false for a controlled rollback.
# true 时不创建业务 Redis 客户端，禁用正文缓存，限流配额按进程独立计算。
BACKEND_REDIS_DISABLED=false
BACKEND_RATE_LIMIT_ENABLED=true
BACKEND_RATE_LIMIT_OPERATION_TIMEOUT=200ms
BACKEND_RATE_LIMIT_LOCAL_MAX_IDENTITIES=1024
BACKEND_RESOURCE_AUTH=16
BACKEND_RESOURCE_READ=64
BACKEND_RESOURCE_WRITE=32
BACKEND_RESOURCE_DATABASE=32
BACKEND_RESOURCE_REBUILD=8
BACKEND_RESOURCE_WAITER=256
BACKEND_TRUSTED_PROXY_CIDRS=
MYSQL_MAX_OPEN_CONNS=8
MYSQL_MAX_IDLE_CONNS=2
MYSQL_CONN_MAX_LIFETIME=3m
MYSQL_TOTAL_MAX_OPEN_CONNS=60
# Production admission default. V1 acceptance temporarily selects 8 through
# the same environment key and restores this value before later cases.
BUSINESS_ASYNC_MAX_OPEN_REQUIREMENTS=10000
BUSINESS_ASYNC_MAX_RETAINED_GROUPS=100000
BUSINESS_ASYNC_MAX_RETAINED_BYTES=1073741824
GOPULSE_UPDATE_VERSION=1.11.7
# The maintained local lifecycle accepts only literal IPv4 loopback publication.
# Remote access requires a separate deployment contract and is not enabled here.
PUBLISHED_HOST=127.0.0.1
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
FRONTEND_PORT=5173
# 本地 Vite 的 API 代理目标；留空时使用 HTTP_PORT。
GOPULSE_API_TARGET=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gopulse
MYSQL_USER=gopulse
MYSQL_PASSWORD=gopulse-mysql
MYSQL_ROOT_PASSWORD=gopulse-root

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=gopulse-redis
REDIS_DB=0
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=noeviction
REDIS_POOL_SIZE=16
REDIS_POOL_TIMEOUT=200ms

RABBITMQ_USER=gopulse
RABBITMQ_PASSWORD=gopulse-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://gopulse:gopulse-rabbitmq@127.0.0.1:5672/

# Phase 3 local Elasticsearch and historical reindex settings.
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_REQUEST_TIMEOUT=3s
SEARCH_REINDEX_BATCH=500

# Phase 2 transactional Outbox dispatcher settings.
OUTBOX_POLL_INTERVAL=1s
OUTBOX_DATABASE_TIMEOUT=2s
OUTBOX_MYSQL_MAX_OPEN_CONNS=4
OUTBOX_PUBLISH_CONCURRENCY=8
OUTBOX_CLAIM_BATCH=50
OUTBOX_LEASE_DURATION=5m
OUTBOX_PUBLISH_TIMEOUT=5s
OUTBOX_RETRY_DELAY=30s
OUTBOX_CLEANUP_INTERVAL=1h
OUTBOX_PUBLISHED_RETENTION=168h
OUTBOX_CLEANUP_BATCH=500

# Phase 2 Business Worker settings. OUTBOX_RETRY_DELAY is also the shared
# durable retry-queue TTL and must therefore match in Backend and Worker.
BUSINESS_WORKER_PREFETCH=10
BUSINESS_WORKER_MAX_RETRIES=3
BUSINESS_WORKER_PUBLISH_TIMEOUT=5s
BUSINESS_WORKER_SHUTDOWN_TIMEOUT=10s
BUSINESS_WORKER_RECONNECT_MIN=500ms
BUSINESS_WORKER_RECONNECT_MAX=30s

# Phase 3 Search Indexer settings. The dedicated retry topology is isolated
# from notification delivery and is declared with this TTL by both Backend and Indexer.
SEARCH_INDEXER_PREFETCH=10
SEARCH_INDEXER_MAX_RETRIES=3
SEARCH_INDEXER_RETRY_DELAY=30s
SEARCH_INDEXER_PUBLISH_TIMEOUT=5s
SEARCH_INDEXER_SHUTDOWN_TIMEOUT=10s
SEARCH_INDEXER_RECONNECT_MIN=500ms
SEARCH_INDEXER_RECONNECT_MAX=30s

# Phase 1 authentication and cache settings.
# Development-only example secret: replace it locally and never reuse it outside local development.
AUTH_JWT_SECRET=local-development-jwt-secret-32-bytes-minimum
AUTH_JWT_TTL=2h
AUTH_COOKIE_NAME=gopulse_session
# Local HTTP development may use false; non-local environments must set this to true.
AUTH_COOKIE_SECURE=false
# 容器内可选的插件启动包路径，留空时通过管理页面安装插件。
REDIS_POST_DETAIL_TTL=5m
REDIS_OPERATION_TIMEOUT=200ms


# Register first, then set the exact user ID for the one-time operations bootstrap.
GOPULSE_BOOTSTRAP_USER_ID=

# Disable only background alert evaluation; management APIs remain available.

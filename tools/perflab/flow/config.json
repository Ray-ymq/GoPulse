{
  "schema_version": "gopulse.pt.config.v1",
  "start_rps": 10,
  "max_rps": 6400,
  "vus": 512,
  "request_timeout_seconds": 5,
  "idle_seconds": 60,
  "warmup_seconds": 30,
  "measurement_seconds": 300,
  "soak_seconds": 1800,

  "max_p95_ms": 1000,
  "max_p99_ms": 2000,
  "min_achieved_ratio": 0.95,
  "mix": [
    {
      "category": "read",
      "percent": 45
    },
    {
      "category": "search",
      "percent": 10
    },
    {
      "category": "notification_bookmark_read",
      "percent": 10
    },
    {
      "category": "content_write",
      "percent": 15
    },
    {
      "category": "interaction_write",
      "percent": 15
    },
    {
      "category": "identity_session",
      "percent": 5
    }
  ]
}
